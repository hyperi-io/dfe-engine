INSERT INTO {{org_id}}.logs_alert
(
    -- alert_confidence_level,
    alert_description,
    alert_framework,
    alert_ratingtime_sla_applies,
    alert_rule_name,
    alert_schedule,
    alert_schedule_duration,
    alert_severity,
    -- alert_ticket_classification,
    -- alert_ticket_id,
    -- alert_ticket_priority,
    alert_triage_score,
    -- alert_triage_steps,
    alert_type,
    -- alert_uid,
    detected_time,
    event_original,
    org_id,
    source_table,
    tactic_id,
    tactic_name,
    tactic_reference,
    technique_id,
    technique_name,
    technique_reference,
    timestamp,
    client_address,
    client_hostname,
    client_ip,
    client_user_name,
    destination_ip,
    device_hostname,
    event_created,
    event_info,
    event_record_subtype,
    event_record_type,
    event_start,
    server_hostname,
    source_hostname,
    source_ip,
    source_user_name
) 
SELECT
    -- alert_confidence_level (reserved for SOC),
    'This query identifies commands used to enable the EDITF_ATTRIBUTESUBJECTALTNAME2 registry flag, which can enable certificate requests specifying a Subject Alternate Name (which in turn can be abused for privilege escalation ).',
    'MITRE ATT&CK',
    'true',
    'win_ad_cert_services_priv_escalation',
    'smd',
    'None',
    'high',
    -- alert_ticket_classification (reserved for SOC),
    -- alert_ticket_id (generated by SOAR),
    -- alert_ticket_priority (reserved for SOC),
    60,
    -- alert_triage_steps (reserved for SOC),
    'Active Directory Certificate Services abuse',
    -- alert_uid (generated by SOAR),
    NOW(),
    event_original,
    '{{org_id}}',
    'windows_audit',
    'TA0004, TA0005',
    'Privilege Escalation, Defense Evasion',
    'https://attack.mitre.org/tactics/TA0004, https://attack.mitre.org/tactics/TA0005',
    'T1548',
    'Abuse Elevation Control Mechanism',
    'https://attack.mitre.org/techniques/T1548',
    timestamp,
    client_address,
    client_hostname,
    client_ip,
    client_user_name,
    destination_ip,
    device_hostname,
    event_created,
    event_info,
    event_record_subtype,
    event_record_type,
    event_start,
    server_hostname,
    source_hostname,
    source_ip,
    source_user_name
FROM {{org_id}}.windows_audit
WHERE (timestamp >= {{from_timestamp}} AND timestamp < {{to_timestamp}}) AND ((process_executable IN ('certutil.exe') AND match(process_commandline, '(?i:(^.*setreg policy\\EditFlags.*))') AND match(process_commandline, '(?i:(^.*EDITF_ATTRIBUTESUBJECTALTNAME2.*))')) OR (process_executable IN ('reg.exe') AND match(process_commandline, '(?i:(^.*add.*))') AND match(process_commandline, '(?i:(^.*\\CertificateAuthority_MicrosoftDefault.Policy.*))') AND match(process_commandline, '(?i:(^.*EditFlags.*))')) OR (process_executable IN ('powershell.exe', 'powershell_ise.exe', 'cmd.exe') AND ((match(process_commandline, '(?i:(^.*Enable-PolicyModuleFlag.*))') AND match(process_commandline, '(?i:(^.*AttributeSubjectAlternativeName.*))')) OR (match(process_commandline, '(?i:(^.*Set-ItemProperty.*))') AND match(process_commandline, '(?i:(^.*sp.*))') AND match(process_commandline, '(?i:(^.*\\CertificateAuthority_MicrosoftDefault.Policy.*))') AND match(process_commandline, '(?i:(^.*EditFlags.*))')))))
    
-- agg term: {} --> CTE and Filter
-- filter_range: [{'range': {'@timestamp': {'gte': '{{from_timestamp}}', 'lt': '{{to_timestamp}}'}}}]
-- must terms: []
-- must not terms: []
-- watcher id: win_ad_cert_services_priv_escalation