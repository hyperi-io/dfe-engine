# Project:   dfe-engine
# File:      .dockerignore
# Purpose:   Trim the Docker build context and strip submodule gitlinks
# Language:  Docker ignore
#
# License:   BUSL-1.1
# Copyright: (c) 2026 HYPERI PTY LIMITED
#
# The image bakes the config/ (dfe-devex) and schemas/ (dfe-schemas) submodule
# trees. Their .git gitlink files must not be copied in - dulwich would try to
# open a gitdir that does not exist in the image. Excluding **/.git also keeps
# the superproject .git out of the build context.

**/.git
**/__pycache__
**/*.pyc
.venv
.ruff_cache
.pytest_cache
.mypy_cache
htmlcov
.coverage
