# Purpose:   Conventional commit validation hook
#
# License:   BUSL-1.1
# Copyright: (c) 2026 HYPERI PTY LIMITED
#
# Install: git config core.hooksPath .githooks

set -euo pipefail

# Validate conventional commit format using hyperi-ci if available.
# Gracefully skip if the subcommand does not exist yet.
if command -v hyperi-ci >/dev/null 2>&1; then
    hyperi-ci check-commit "$1" 2>/dev/null || true
elif command -v uvx >/dev/null 2>&1; then
    uvx hyperi-ci check-commit "$1" 2>/dev/null || true
fi
