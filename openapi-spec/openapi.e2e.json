{
  "openapi": "3.1.0",
  "info": {
    "title": "DFE Engine API \u2014 E2E",
    "description": "Playwright helpers for `make e2e-server`. Unauthenticated. Mounted and documented only in that mode \u2014 not in the product spec.",
    "version": "1.8.0"
  },
  "paths": {
    "/api/e2e/status": {
      "get": {
        "tags": [
          "E2E"
        ],
        "summary": "E2E Status",
        "description": "Confirm this process mounted the e2e-server helpers.",
        "operationId": "e2e_status_api_e2e_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/E2EStatusResponse"
                }
              }
            }
          }
        },
        "security": [],
        "x-cli": {
          "enabled": false
        }
      }
    },
    "/api/e2e/seed-admin": {
      "post": {
        "tags": [
          "E2E"
        ],
        "summary": "Seed Admin",
        "description": "Create or reset a local admin in dfe-admins. Unauthenticated by design.",
        "operationId": "seed_admin_api_e2e_seed_admin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedAdminResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [],
        "x-cli": {
          "enabled": false
        }
      }
    }
  },
  "components": {
    "schemas": {
      "E2EStatusResponse": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "E2EStatusResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SeedAdminRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Local admin username to seed",
            "default": "admin"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "Plaintext password (hashed before storage)",
            "default": "changeme"
          }
        },
        "type": "object",
        "title": "SeedAdminRequest"
      },
      "SeedAdminResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          }
        },
        "type": "object",
        "required": [
          "username",
          "created"
        ],
        "title": "SeedAdminResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "E2E",
      "description": "Playwright helpers for `make e2e-server`. Unauthenticated. Mounted and documented only in that mode \u2014 not in the product spec."
    }
  ]
}
