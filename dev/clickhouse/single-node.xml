<!--
  Project:   dfe-engine
  File:      dev/clickhouse/single-node.xml
  Purpose:   One-node ClickHouse with its own Keeper, for the local dev compose service

  License:   BUSL-1.1
  Copyright: (c) 2026 HYPERI PTY LIMITED

  DFE creates every table as a ReplicatedMergeTree inside a Replicated database,
  which needs Keeper and the cluster, shard and replica macros. This is the
  one-node form of dfe-docker's config/clickhouse/replication.xml.
-->
<clickhouse>
  <keeper_server>
    <four_letter_word_white_list>ruok,isro,mntr,srvr,stat</four_letter_word_white_list>
    <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
    <raft_configuration>
      <server>
        <hostname>127.0.0.1</hostname>
        <id>1</id>
        <port>9234</port>
      </server>
    </raft_configuration>
    <server_id>1</server_id>
    <tcp_port>9181</tcp_port>
  </keeper_server>

  <macros>
    <cluster>dfe</cluster>
    <replica>r1</replica>
    <shard>01</shard>
  </macros>

  <remote_servers>
    <dfe>
      <shard>
        <replica>
          <host>127.0.0.1</host>
          <port>9000</port>
        </replica>
      </shard>
    </dfe>
  </remote_servers>

  <zookeeper>
    <node>
      <host>127.0.0.1</host>
      <port>9181</port>
    </node>
  </zookeeper>
</clickhouse>
