[submodule "schemas"]
	path = schemas
	url = https://github.com/hyperi-io/dfe-schemas.git
[submodule "config"]
	path = config
	url = https://github.com/hyperi-io/dfe-devex.git
[submodule "hyperi-ai"]
	path = hyperi-ai
	url = https://github.com/hyperi-io/hyperi-ai.git
	update = rebase
	fetchRecurseSubmodules = true
