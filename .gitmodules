[submodule "ci"]
	path = ci
	url = https://github.com/hyperi-io/ci.git
	update = rebase
	fetchRecurseSubmodules = true
[submodule "schemas"]
	path = schemas
	url = https://github.com/hyperi-io/dfe-schemas.git
[submodule "config"]
	path = config
	url = https://github.com/hyperi-io/dfe-devex.git
[submodule "tooling"]
	path = tooling
	url = https://github.com/hyperi-io/tooling.git
	update = rebase
	fetchRecurseSubmodules = true
