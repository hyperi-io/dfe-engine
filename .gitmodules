[submodule "ci"]
	path = ci
	url = https://github.com/hyperi-io/ci.git
	update = rebase
	fetchRecurseSubmodules = true
[submodule "ai"]
	path = ai
	url = https://github.com/hyperi-io/ai.git
	update = rebase
	fetchRecurseSubmodules = true
[submodule "schemas"]
	path = schemas
	url = https://github.com/hyperi-io/dfe-schemas.git
[submodule "config"]
	path = config
	url = https://github.com/hyperi-io/dfe-devex.git
