{
  "version": "0.1.0",
  "name": "DFE Throughput",
  "tiles": [
    {
      "id": "events-total",
      "x": 0,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Events ingested",
        "source": "default",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "bytes-total",
      "x": 4,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Bytes ingested",
        "source": "default",
        "displayType": "number",
        "numberFormat": {
          "output": "byte"
        },
        "select": [
          {
            "aggFn": "sum",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "coalesce(length(_raw), length(toString(_json)))"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "active-orgs",
      "x": 8,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Active orgs",
        "source": "default",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count_distinct",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "_org_id"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "active-sources",
      "x": 12,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Active sources",
        "source": "default",
        "displayType": "number",
        "select": [
          {
            "aggFn": "count_distinct",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "_source"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "lag-p95",
      "x": 16,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Ingest lag p95 (ms)",
        "source": "default",
        "displayType": "number",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.95,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('millisecond', _timestamp_received, _timestamp_load)",
            "alias": "p95"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "lag-max",
      "x": 20,
      "y": 0,
      "w": 4,
      "h": 3,
      "config": {
        "name": "Ingest lag max (ms)",
        "source": "default",
        "displayType": "number",
        "select": [
          {
            "aggFn": "max",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('millisecond', _timestamp_received, _timestamp_load)"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "events-by-org",
      "x": 0,
      "y": 3,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Events per interval by org",
        "source": "default",
        "displayType": "stacked_bar",
        "granularity": "auto",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "_org_id"
      }
    },
    {
      "id": "events-by-source",
      "x": 12,
      "y": 3,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Events per interval by source",
        "source": "default",
        "displayType": "stacked_bar",
        "granularity": "auto",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "_source"
      }
    },
    {
      "id": "lag-percentiles",
      "x": 0,
      "y": 9,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Ingest lag percentiles (ms)",
        "source": "default",
        "displayType": "line",
        "granularity": "auto",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('millisecond', _timestamp_received, _timestamp_load)",
            "alias": "p50"
          },
          {
            "aggFn": "quantile",
            "level": 0.9,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('millisecond', _timestamp_received, _timestamp_load)",
            "alias": "p90"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('millisecond', _timestamp_received, _timestamp_load)",
            "alias": "p99"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "event-skew",
      "x": 12,
      "y": 9,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Event-time skew distribution (s)",
        "source": "default",
        "displayType": "heatmap",
        "granularity": "auto",
        "select": [
          {
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "dateDiff('second', _timestamp, _timestamp_received)",
            "countExpression": "count()"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
    {
      "id": "top-orgs",
      "x": 0,
      "y": 15,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Top orgs by volume",
        "source": "default",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "events"
          },
          {
            "aggFn": "sum",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "coalesce(length(_raw), length(toString(_json)))",
            "alias": "bytes"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": [
          { "valueExpression": "_org_id" }
        ],
        "selectGroupBy": true,
        "orderBy": "events DESC",
        "limit": {
          "limit": 20
        }
      }
    },
    {
      "id": "source-freshness",
      "x": 12,
      "y": 15,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Source freshness (newest event)",
        "source": "default",
        "displayType": "table",
        "select": [
          {
            "aggFn": "max",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "_timestamp",
            "alias": "newest_event"
          },
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "",
            "alias": "events"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": [
          { "valueExpression": "_source" }
        ],
        "selectGroupBy": true,
        "orderBy": "newest_event ASC",
        "limit": {
          "limit": 50
        }
      }
    }
  ],
  "tags": [
    "dfe",
    "provisioned"
  ]
}
