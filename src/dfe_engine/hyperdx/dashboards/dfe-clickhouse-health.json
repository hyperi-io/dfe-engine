      "y": 21,
      "w": 12,
      "h": 6,
      "config": {
        "name": "Largest tables by rows",
        "source": "otel_metrics",
        "displayType": "table",
        "select": [
          {
            "aggFn": "max",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "alias": "rows",
            "metricType": "gauge",
            "metricName": "clickhouse_table_rows"
          }
        ],
        "where": "",
        "whereLanguage": "lucene",
        "groupBy": "concat(Attributes['database'], '.', Attributes['table'])",
        "orderBy": "rows DESC",
        "limit": {
          "limit": 20
        }
      }
    },
