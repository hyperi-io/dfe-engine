    {
      "id": "insert-latency",
      "x": 0,
      "y": 9,
      "w": 12,
      "h": 6,
      "config": {
        "name": "ClickHouse insert latency (s)",
        "source": "otel_metrics",
        "displayType": "line",
        "granularity": "auto",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "alias": "p50",
            "metricType": "histogram",
            "metricName": "insert_latency_seconds"
          },
          {
            "aggFn": "quantile",
            "level": 0.95,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "alias": "p95",
            "metricType": "histogram",
            "metricName": "insert_latency_seconds"
          },
          {
            "aggFn": "quantile",
            "level": 0.99,
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": "Value",
            "alias": "p99",
            "metricType": "histogram",
            "metricName": "insert_latency_seconds"
          }
        ],
        "where": "",
        "whereLanguage": "lucene"
      }
    },
