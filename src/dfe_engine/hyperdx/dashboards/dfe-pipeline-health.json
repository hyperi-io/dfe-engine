        "source": "otel_logs",
        "displayType": "stacked_bar",
        "granularity": "auto",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "lucene",
            "valueExpression": ""
          }
        ],
        "where": "SeverityNumber >= 17",
        "whereLanguage": "sql",
        "groupBy": "ServiceName"
