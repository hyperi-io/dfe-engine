{
  "template": {
    "settings": {
      "index.codec": "best_compression",
      "index.mapping.total_fields.limit": "10000",
      "index.mapping.ignore_malformed": "true",
      "index.search.slowlog.threshold.fetch.debug": "0ms",
      "index.search.slowlog.threshold.fetch.info": "1s",
      "index.search.slowlog.threshold.query.debug": "0ms",
      "index.search.slowlog.threshold.query.info": "1s",
      "index.refresh_interval": "30s",
      "index.number_of_shards": "1",
      "index.translog.sync_interval": "1m",
      "index.max_docvalue_fields_search": "350",
      "index.query.default_field": "message",
      "index.analysis.normalizer.lowercase_normalizer.filter": [
        "lowercase"
      ],
      "index.analysis.normalizer.lowercase_normalizer.type": "custom",
      "index.analysis.analyzer.log_analyzer.lowercase": "true",
      "index.analysis.analyzer.log_analyzer.pattern": "\\W+",
      "index.analysis.analyzer.log_analyzer.type": "pattern",
      "index.number_of_replicas": "0",
      "replication.type": "SEGMENT",
      "translog.flush_threshold_size": "2048MB"
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "no_index_fields_past_depth_2": {
            "path_match": "*.*",
            "mapping": {
              "type": "object",
              "enabled": false
            },
            "match_mapping_type": "object"
          }
        },
        {
          "create_keyword_index_for_all_string_fields": {
            "mapping": {
              "normalizer": "lowercase_normalizer",
              "ignore_above": 1000,
              "type": "keyword"
            },
            "match_mapping_type": "string",
            "match": "*"
          }
        }
      ],
      "properties": {
        "timestamp_finalise": {
          "type": "date"
        },
        "timestamp_finalise_epochms": {
          "type": "long"
        },
        "timestamp_epochms": {
          "type": "long"
        },
        "timestamp_load": {
          "type": "date"
        },
        "tags": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "tags.event.error": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "org_id": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "site_id": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "type": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "category": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "collector": {
              "type": "object",
              "properties": {
                "hostname": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "timezone": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "host": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "source": {
                  "normalizer": "lowercase_normalizer",
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "timestamp": {
                  "type": "date"
                }
              }
            }
          }
        },
        "timestamp_collector": {
          "type": "date"
        },
        "@timestamp": {
          "type": "date"
        },
        "event_hash": {
          "normalizer": "lowercase_normalizer",
          "ignore_above": 1024,
          "type": "keyword"
        },
        "org_id": {
          "normalizer": "lowercase_normalizer",
          "ignore_above": 1024,
          "type": "keyword"
        },
        "timestamp_load_epochms": {
          "type": "long"
        },
        "logoriginal": {
          "norms": false,
          "type": "text"
        },
        "timestamp_collector_epochms": {
          "type": "long"
        },
        "timestamp_received_epochms": {
          "type": "long"
        },
        "timestamp_received": {
          "type": "date"
        }
      }
    }
  },
  "_meta": {
    "description": "DEFAULT HyperSec OpenSearch default component streaming index template v3.2.6.  External source support merge. Requires OpenSearch v2.8 and above."
  }
}