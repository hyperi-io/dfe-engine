{
  "id": "hypersec-ism-hot-warm-delete",
  "policy": {
    "policy_id": "hypersec-ism-hot-warm-delete",
    "description": "DEVTEST HyperSec XDR streaming hot-warm-delete ISM streaming policy v3.2.9. External source support merge. 10GB shard size -> Imitation Warm (on Hot) 1 day -> delete",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "retry": {
              "count": 10,
              "backoff": "exponential",
              "delay": "1h"
            },
            "allocation": {
              "require": {
                "box_type": "hot"
              },
              "include": {},
              "exclude": {},
              "wait_for": false
            }
          },
          {
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "rollover": {
              "min_primary_shard_size": "45gb",
              "copy_alias": false
            }
          }
        ],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": {
              "min_rollover_age": "1m"
            }
          }
        ]
      },
      {
        "name": "warm",
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "1d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "timeout": "1h",
            "retry": {
              "count": 10,
              "backoff": "exponential",
              "delay": "10m"
            },
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "logs-*",
          "ref-*",
          ".ds-logs-*",
          ".ds-ref-*"
        ],
        "priority": 100
      }
    ]
  }
}