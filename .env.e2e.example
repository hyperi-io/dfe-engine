# DFE Engine - local development configuration
#
# Copy to .env.e2e (gitignored) and adjust. Engine vars use the DFE_ENGINE_ prefix (K8s / scalo
# compatible). The engine reads these via settings.py; unset vars fall back to
# code defaults. Put real secrets in .env, NEVER here.

# =============================================================================
# Deployment posture
# =============================================================================
# "production" (default, secure) REFUSES the placeholder jwt_secret when auth is
# on. Use "dev" locally so the placeholder works (dev|development|local|test|ci
# are all treated as non-production).
DFE_ENGINE_ENV=test

# =============================================================================
# API server
# =============================================================================
DFE_ENGINE_API_HOST=0.0.0.0
DFE_ENGINE_API_PORT=8003
# JWT signing secret (HS256, >= 32 bytes). MUST be overridden in production.
DFE_ENGINE_API_JWT_SECRET=dev-secret-key-change-in-production
# DFE_ENGINE_API_JWT_EXPIRE_MINUTES=60
# DFE_ENGINE_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Auth (RBAC)
# =============================================================================
DFE_ENGINE_AUTH_ENABLED=true
# DFE_ENGINE_AUTH_DIR=./config/auth
# Local accounts (bootstrapped when local auth is enabled):
# DFE_ENGINE_AUTH_LOCAL_ENABLED=true
# DFE_ENGINE_AUTH_LOCAL_ADMIN_NAME=admin
# DFE_ENGINE_AUTH_LOCAL_ADMIN_PASSWORD=changeme

# =============================================================================
# OIDC (external IdP; optional - read by the OIDC provider loader)
# =============================================================================
# Entra ID (Microsoft)
# DFE_OIDC_ENTRA_CLIENT_ID=
# DFE_OIDC_ENTRA_CLIENT_SECRET=
# DFE_OIDC_ENTRA_TENANT_ID=
# Google Workspace
# DFE_OIDC_GOOGLE_CLIENT_ID=
# DFE_OIDC_GOOGLE_CLIENT_SECRET=
# DFE_GOOGLE_SA_JSON=

# =============================================================================
# ClickHouse (dfe-docker: `cd ../dfe-docker && docker compose --profile clickhouse up -d`)
# =============================================================================
# Host-run dfe-engine → localhost:8123. The password is the one `docker compose -f
# docker-compose.dev.yaml up -d clickhouse` sets. Against dfe-docker, copy its
# `CLICKHOUSE_PASSWORD` instead (generated by `make init` there, empty is rejected).
DFE_ENGINE_CLICKHOUSE_HOST=localhost
DFE_ENGINE_CLICKHOUSE_PORT=8123
DFE_ENGINE_CLICKHOUSE_USERNAME=default
DFE_ENGINE_CLICKHOUSE_PASSWORD=dfe-local-dev
DFE_ENGINE_CLICKHOUSE_SECURE=false
DFE_ENGINE_CLICKHOUSE_VERIFY=false
DFE_ENGINE_CLICKHOUSE_DATABASE=default
# `make e2e-server` overrides the data/hunts DBs to dfe_e2e / dfe_e2e_hunts
# (and drops them on each fresh start). Leave `dfe` here for a manual run.
DFE_ENGINE_CLICKHOUSE_DATA_DATABASE=dfe

DFE_ENGINE_DEFAULT_TABLE_PROFILE=timeseries
DFE_ENGINE_CLICKHOUSE_BOOTSTRAP_TABLES=true


# Connection pool settings (optional)
# DFE_ENGINE_CLICKHOUSE_CONNECTIONS_MAX=300

# Restricted query-views reader: the query_reader service user minted by the CH
# RBAC reconciler (password from the engine's secrets provider, ch/service/query_reader).
# DFE_ENGINE_QUERY_VIEWS_RESTRICTED_USER=dfe_query_reader
# DFE_ENGINE_QUERY_VIEWS_RESTRICTED_PASSWORD=

# =============================================================================
# Secrets provider (secrets the engine MINTS - per-group CH passwords, OIDC, etc.)
# =============================================================================
# provider: file (docker) | openbao (k8s) | aws
# DFE_ENGINE_SECRETS_PROVIDER=file
# DFE_ENGINE_SECRETS_PATH=./.secrets            # file provider root
# DFE_ENGINE_SECRETS_ADDR=                      # openbao address
# DFE_ENGINE_SECRETS_MOUNT=                     # openbao KV mount (prefixes the path)
# DFE_ENGINE_SECRETS_ROLE=                      # openbao AppRole role_id (secret_id via VAULT_SECRET_ID env)

# =============================================================================
# Org ClickHouse RBAC reconcile
# =============================================================================
# Reconciles quota tiers + service roles + per-org _org_id row policies into CH
# at startup. On by default. Manual trigger: `dfe local governed reconcile-ch-rbac`
# or POST /api/v1/governance/ch-rbac/reconcile.
# DFE_ENGINE_TENANT_ISOLATION_ENABLED=true

# =============================================================================
# Gitops (governed-ops write path; off by default)
# =============================================================================
# DFE_ENGINE_GITOPS_ENABLED=false
# DFE_ENGINE_GITOPS_REPO_URL=
# DFE_ENGINE_GITOPS_BRANCH=main
# DFE_ENGINE_GITOPS_LOCAL_PATH=/var/run/dfe/deploy-repo
# DFE_ENGINE_GITOPS_USERNAME=
# DFE_ENGINE_GITOPS_TOKEN=
# DFE_ENGINE_GITOPS_AUTHOR_NAME=dfe-engine
# DFE_ENGINE_GITOPS_AUTHOR_EMAIL=dfe-engine@hyperi.io

# =============================================================================
# HyperDX (optional)
# =============================================================================
# DFE_ENGINE_HYPERDX_ENABLED=false
# DFE_ENGINE_HYPERDX_BASE_URL=

# =============================================================================
# Config directories
# =============================================================================
# DFE_CONFIG_DIR auto-resolves sources/ services/ hunts/ rules/ queries/ etc.
# `make e2e-server` overrides these to tmp/e2e/{config,schemas} so this process
# never writes into ./config or the schemas/ submodule.
# DFE_CONFIG_DIR=./config
# DFE_ENGINE_SCHEMAS_DIR=./schemas
# DFE_ENGINE_SOURCES_DIR=./sources
# DFE_ENGINE_FIELDMAPS_DIR=./fieldmaps
# DFE_ENGINE_SERVICES_CONFIG_YAML_DIR=./services
# DFE_ENGINE_HUNTS_DIR=./hunts

# =============================================================================
# Kafka (the engine reads only these; brokers are deployed by dfe-infra)
# =============================================================================
# DFE_ENGINE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# DFE_ENGINE_KAFKA_SECURITY_PROTOCOL=SASL_SSL   # SCRAM-SHA-512 is the DFE standard
# No local broker? Run brokerless, or startup waits out the broker and stays NotReady.
# DFE_ENGINE_TRANSPORT_BUS_PRESENT=false
# DFE_ENGINE_TRANSPORT_DEFAULT=direct           # required once there is no bus

# =============================================================================
# Elastic-schema converter (upload limits)
# =============================================================================
# DFE_ENGINE_API_ELASTIC_CONVERTER_MAX_UPLOAD_BYTES=5242880          # 5 MiB
# DFE_ENGINE_API_ELASTIC_CONVERTER_READ_CHUNK_SIZE=65536             # 64 KiB
# DFE_ENGINE_API_ELASTIC_CONVERTER_CONTENT_LENGTH_SLACK_BYTES=262144 # 256 KiB

# =============================================================================
# Storage (artifacts; on-prem / Rancher)
# =============================================================================
# DFE_ENGINE_STORAGE_TYPE=auto                  # auto | local | s3 | http
# DFE_ENGINE_STORAGE_PATH=./artifacts
# DFE_ENGINE_S3_REGION=

# =============================================================================
# Integration tests (real ClickHouse)
# =============================================================================
# The tiered ch fixture (tests/integration/conftest.py) auto-picks, in order:
#   1 cluster: a non-localhost DFE_ENGINE_CLICKHOUSE_* (above) or DFE_TEST_CH_*
#   2 remote:  a docker host over ssh (DFE_TEST_DOCKER_HOST=user@host)
#   3 local:   a local docker ClickHouse
# Force a tier with DFE_TEST_TIER=cluster|remote|local; keep the spun container
# with DFE_TEST_KEEP=1.
# DFE_TEST_TIER=cluster
# DFE_TEST_CH_HOST=clickhouse.example.internal
# DFE_TEST_CH_PORT=8123
# DFE_TEST_CH_USER=default
# DFE_TEST_CH_PASSWORD=
# DFE_TEST_DOCKER_HOST=user@docker-host.example.internal
