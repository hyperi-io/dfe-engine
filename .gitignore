.bt-*/

# Generated config files
dfe_package_testing.yaml
meta_schemas.zip

# Docker
docker-compose.yml

# Runtime config directory (created by bootstrap). Anchored to the root so the
# fixtures under tests/resources/test_hunts/hunt_config/config/ stay tracked.
/config/

# Local environment files (never commit -- contain secrets)
.env.*
!.env*.example
!.env.example.*

# Agent working docs: local by default, never committed.
docs/superpowers/
# Local planning docs (planning skill): local by default, NEVER committed.
# Only docs/plans/shared/ is committable (explicit opt-in). Use `/*` (not a bare
# dir) so git still descends into shared/ for the negation to re-include it.
docs/plans/*
!docs/plans/shared/
.ai-version

