# =============================================================================

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment/secrets
.env
.env.local
.env.*.local
.secrets/

# Logs
*.log

# Build outputs
dist/
dist-bin/
build/
out/

# Test/coverage
test-results/
coverage/
coverage.xml

# =============================================================================

# Python (from ci/templates/gitignore/python.gitignore)

# =============================================================================

# Python bytecode
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/

# Packaging
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# =============================================================================

# Project-specific

# =============================================================================

# Test artifacts
cov.xml
tests/job_outputs/
tests/test_logs/
tests/tmp/

# Generated config files
dfe_package_testing.yaml
meta_schemas.zip

# Docker
docker-compose.yml

# Runtime config directory (created by bootstrap)
config/

# OS junk (never useful in repo)
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor / IDE local state
.idea/
.vscode/

# Local environment files (never commit -- contain secrets)
.env
.env.*
!.env.example
!.env.example.*

# them alone if already present.
docs/superpowers/
# Local planning docs (planning skill): local by default, NEVER committed.
# Only docs/plans/shared/ is committable (explicit opt-in). Use `/*` (not a bare
# dir) so git still descends into shared/ for the negation to re-include it.
docs/plans/*
!docs/plans/shared/
.mcp.json
.ai-version

# committed -- mirrored in .git/info/exclude.
CLAUDE.md
TODO.md
AGENTS.md
GEMINI.md
.claude/
.codex/
.cursor/
.gemini/
.cursorrules

# Git worktrees (local dev convenience)
.worktrees/

# Python build artefacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python virtual envs and caches
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
pip-wheel-metadata/

# Local scratch / tmp (CORE.md: scratch goes here, gitignored, NOT
# /tmp). Bare patterns (no leading slash) match a tmp dir at ANY
# depth, so these cover top-level .tmp/ and tmp/ as well as nested
# ones like tests/tmp/. Mirrored in attach.py _DEFAULT_EXCLUDES.
.tmp/
tmp/

# Playwright MCP session artefacts (tool output, never committed)
.playwright-mcp/

# Runtime-generated engine state when run from the repo root (dev runs):
# SourceDeploymentStore + pipeline output default to cwd-relative dirs.
# Generated, never committed.
.benchmarks/
/pipelines/
/source-builds/
/source-deploys/
/source-plans/
