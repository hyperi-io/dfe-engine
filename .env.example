# DFE Engine Configuration Example
# Using DFE_ prefix for K8s/hyperi-pylib config compatibility
#
# Copy this to .env and modify as needed for local development.
# All variables use DFE_ prefix for consistency with K8s deployments.

# =============================================================================
# Docker Image Versions (for local development containers)
# =============================================================================
# Set these to pin specific versions, or leave unset for latest
# DFE_CLICKHOUSE_VERSION=latest   # ClickHouse version tag (e.g., 24.8, 24.12, latest)
# DFE_POSTGRES_VERSION=17         # PostgreSQL major version (e.g., 16, 17)

# =============================================================================
# ClickHouse Configuration
# =============================================================================
# To use local Docker container: leave DFE_CLICKHOUSE_HOST unset or commented
# To use external server: uncomment and set DFE_CLICKHOUSE_HOST
# DFE_CLICKHOUSE_HOST=your-clickhouse-server.example.com
DFE_CLICKHOUSE_PORT=8123
DFE_CLICKHOUSE_NATIVE_PORT=9000
DFE_CLICKHOUSE_USERNAME=default
DFE_CLICKHOUSE_PASSWORD=
DFE_CLICKHOUSE_DATABASE=default
DFE_CLICKHOUSE_SECURE=false
DFE_CLICKHOUSE_VERIFY=false

# Connection pool settings (optional)
DFE_CLICKHOUSE_CONNECTIONS_MIN=10
DFE_CLICKHOUSE_CONNECTIONS_MAX=300

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# To use local Docker container: leave DFE_POSTGRES_HOST unset or commented
# To use external server: uncomment and set DFE_POSTGRES_HOST
# DFE_POSTGRES_HOST=your-postgres-server.example.com
DFE_POSTGRES_PORT=5432
DFE_POSTGRES_USER=postgres
DFE_POSTGRES_PASSWORD=postgres
DFE_POSTGRES_DATABASE=dfe_engine

# =============================================================================
# Kafka Configuration
# =============================================================================
DFE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DFE_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# With SASL authentication (uncomment and configure)
# DFE_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# DFE_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# DFE_KAFKA_SASL_USERNAME=admin
# DFE_KAFKA_SASL_PASSWORD=your-password

# With TLS (uncomment and configure)
# DFE_KAFKA_SECURITY_PROTOCOL=SASL_SSL

# =============================================================================
# Hunt Scheduler Settings
# =============================================================================
DFE_HUNT_LOG_PATH=hunt_log_path

# =============================================================================
# Storage Configuration (for on-prem/Rancher deployments)
# =============================================================================
# DFE_STORAGE_TYPE=auto           # auto, local, s3, http
# DFE_STORAGE_PATH=./artifacts    # Local path, S3 URI (s3://bucket/prefix), or HTTP URL
# DFE_S3_BUCKET=                  # S3 bucket name (when using s3 type)
# DFE_S3_REGION=                  # AWS region (when using s3 type)

# =============================================================================
# Artifactory Configuration (for template downloads)
# =============================================================================
# DFE_ARTIFACTORY_URL=https://your-artifactory.example.com/api/pypi/
# DFE_ARTIFACTORY_USERNAME=
# DFE_ARTIFACTORY_PASSWORD=
# DFE_TEMPLATES_VERSION=latest
