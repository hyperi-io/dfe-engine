# DFE Engine - local development configuration
#
# Copy to .env (gitignored) and adjust. All vars use the DFE_ prefix (K8s / scalo
# compatible). The engine reads these via settings.py; unset vars fall back to
# code defaults. Put real secrets in .env, NEVER here.

# =============================================================================
# Deployment posture
# =============================================================================
# "production" (default, secure) REFUSES the placeholder jwt_secret when auth is
# on. Use "dev" locally so the placeholder works (dev|development|local|test|ci
# are all treated as non-production).
DFE_ENV=dev

# =============================================================================
# API server
# =============================================================================
DFE_API_HOST=0.0.0.0
DFE_API_PORT=8003
# JWT signing secret (HS256, >= 32 bytes). MUST be overridden in production.
DFE_API_JWT_SECRET=dev-secret-key-change-in-production
# DFE_API_JWT_EXPIRE_MINUTES=60
# DFE_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Auth (RBAC)
# =============================================================================
DFE_AUTH_ENABLED=false
# DFE_AUTH_DIR=./config/auth
# Local accounts toggle. Only the toggle is read; the admin account is seeded from
# DFE_ADMIN_PASSWORD (below), not from per-role DFE_AUTH_LOCAL_* passwords.
# DFE_AUTH_LOCAL_ENABLED=true
# Sigma git-provider host allowlist (comma-list; empty = any host). When set, a
# git_repo provider url must resolve to one of these hosts (SSRF hardening; a
# local_files provider directory is always confined under the config dir).
# DFE_SIGMA_ALLOWED_HOSTS=github.com,gitlab.com

# =============================================================================
# OIDC (external IdP; optional - read by the OIDC provider loader)
# =============================================================================
# Entra ID (Microsoft)
# DFE_OIDC_ENTRA_CLIENT_ID=
# DFE_OIDC_ENTRA_CLIENT_SECRET=
# DFE_OIDC_ENTRA_TENANT_ID=
# Google Workspace
# DFE_OIDC_GOOGLE_CLIENT_ID=
# DFE_OIDC_GOOGLE_CLIENT_SECRET=
# DFE_GOOGLE_SA_JSON=

# =============================================================================
# ClickHouse
# =============================================================================
# DevEx PET cluster over the VPN: plain HTTP on :8123 (NOT TLS, so secure=false).
# For a local docker CH set HOST=localhost. Password: see the Secrets note - for
# the DevEx cluster it lives in OpenBao (kv/services/clickhouse).
#
# ---------------------------------------------------------------------------
# REQUIRED CH SERVER CONFIG (tenant isolation depends on it - deploy, NOT DDL):
#   <custom_settings_prefixes>DFE_</custom_settings_prefixes>   (config.xml)
# The tenant row policy filters on getSetting('DFE_current_tenant_id'), and the
# engine injects that custom setting per query. Without this prefix on the CH
# SERVER, CH rejects every 'DFE_*' setting (CREATE USER ... SETTINGS and each
# per-query SETTINGS) and tenant scoping cannot apply. This is NOT something the
# engine reconciler can set - it is CH server config owned by the deployer:
#   - dfe-infra: the ClickHouse chart values (config.xml / users.d overlay)
#   - dfe-docker: the CH container config.xml (or a mounted users.d/*.xml)
# See docs/RBAC.md section 5.
# ---------------------------------------------------------------------------
DFE_CLICKHOUSE_HOST=clickhouse.devex.hyperi.io
DFE_CLICKHOUSE_PORT=8123
DFE_CLICKHOUSE_USERNAME=default
DFE_CLICKHOUSE_PASSWORD=
DFE_CLICKHOUSE_SECURE=false
DFE_CLICKHOUSE_VERIFY=false
DFE_CLICKHOUSE_DATABASE=default
# The effective DATA database (tables/views land here). Never hardcode 'dfe'.
DFE_CLICKHOUSE_DATA_DATABASE=dfe
# DFE_CLICKHOUSE_TOPOLOGY=single         # single | cluster
# DFE_CLICKHOUSE_CONNECTIONS_MIN=10
# DFE_CLICKHOUSE_CONNECTIONS_MAX=300

# Restricted query-views reader: the query_reader service user minted by the CH
# RBAC reconciler (password from the secrets seam, ch/service/query_reader).
# DFE_QUERY_VIEWS_RESTRICTED_USER=dfe_query_reader
# DFE_QUERY_VIEWS_RESTRICTED_PASSWORD=

# Fixed CH users by privilege (connections.yaml). CH_DEFAULT_PASSWORD is the CH
# superuser (admin/default connection). The other three are MINTED by the CH RBAC
# reconciler (secrets seam ch/fixed/<user>); wire the minted plaintext into these
# envs at deploy so the analyst / read-only / tenant-reader connections can auth.
# CH_DEFAULT_PASSWORD=
# CH_ANALYST_PASSWORD=
# CH_ANALYST_RO_PASSWORD=
# CH_TENANT_READER_PASSWORD=

# =============================================================================
# Secrets seam (secrets the engine MINTS - per-group CH passwords, OIDC, etc.)
# =============================================================================
# provider: file | ansible_vault (docker) | openbao (k8s) | aws | gcp | azure
# DFE_SECRETS_PROVIDER=file
# DFE_SECRETS_PATH=./.secrets            # file / ansible_vault root
# DFE_SECRETS_ADDR=                      # openbao address
# DFE_SECRETS_MOUNT=                     # openbao KV mount (prefixes the path)
# DFE_SECRETS_ROLE=                      # openbao AppRole role_id (secret_id via VAULT_SECRET_ID env)

# =============================================================================
# Org ClickHouse RBAC reconcile (opt-in)
# =============================================================================
# Reconciles quota tiers + service roles + fixed users by privilege + ONE
# DFE_current_tenant_id row policy per _org_id table into CH at startup. Off by
# default. Manual trigger: `dfe-api governed reconcile-ch-rbac` or
# POST /api/v1/governance/ch-rbac/reconcile. Requires the custom_settings_prefixes
# CH server config (see the ClickHouse section above).
# DFE_ORG_PROVISIONING_ENABLED=false

# =============================================================================
# Gitops (governed-ops write path; off by default)
# =============================================================================
# DFE_GITOPS_ENABLED=false
# DFE_GITOPS_REPO_URL=
# DFE_GITOPS_BRANCH=main
# DFE_GITOPS_LOCAL_PATH=/var/run/dfe/deploy-repo
# DFE_GITOPS_USERNAME=
# DFE_GITOPS_TOKEN=
# DFE_GITOPS_AUTHOR_NAME=dfe-engine
# DFE_GITOPS_AUTHOR_EMAIL=dfe-engine@hyperi.io

# =============================================================================
# HyperDX (optional)
# =============================================================================
# DFE_HYPERDX_ENABLED=false
# DFE_HYPERDX_BASE_URL=
# DFE_HYPERDX_API_KEY_ENV=HYPERDX_API_KEY
#
# Team model posture (see docs/RBAC.md section 7).
# DFE_HYPERDX_PER_GROUP=false  -> GA default: ONE shared HyperDX team (below) that
#   every provisioned user joins. Tenant isolation is NOT the team - it is the
#   per-connection DFE_current_tenant_id setting on the shared dfe_tenant_reader
#   CH user (the custom-settings model). Fewer teams, scales to thousands of orgs.
# DFE_HYPERDX_PER_GROUP=true   -> post-GA: the richer per-org team (customer-<org>)
#   provisioned per org.
# DFE_HYPERDX_PER_GROUP=false
# Name of the single shared HyperDX team used when PER_GROUP is false (GA).
# DFE_GA_TEAM_NAME=dfe

# =============================================================================
# Config directories
# =============================================================================
# DFE_CONFIG_DIR auto-resolves sources/ services/ hunts/ rules/ queries/ etc.
# DFE_CONFIG_DIR=./config
DFE_SCHEMAS_DIR=./schemas
# DFE_SOURCES_DIR=./sources
# DFE_FIELDMAPS_DIR=./fieldmaps
# DFE_SERVICES_CONFIG_YAML_DIR=./services
# DFE_HUNTS_DIR=./hunts
# DFE_DEPLOYMENT_CONFIG_DIR=./deploy
# DFE_QUERY_YAML_DIR=./queries

# =============================================================================
# Kafka (the engine reads only these; brokers are deployed by dfe-infra)
# =============================================================================
# DFE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# DFE_KAFKA_SECURITY_PROTOCOL=SASL_SSL   # SCRAM-SHA-512 is the DFE standard

# =============================================================================
# Elastic-schema converter (upload limits)
# =============================================================================
# DFE_API_ELASTIC_CONVERTER_MAX_UPLOAD_BYTES=5242880          # 5 MiB
# DFE_API_ELASTIC_CONVERTER_READ_CHUNK_SIZE=65536             # 64 KiB
# DFE_API_ELASTIC_CONVERTER_CONTENT_LENGTH_SLACK_BYTES=262144 # 256 KiB

# =============================================================================
# Storage (artifacts; on-prem / Rancher)
# =============================================================================
# DFE_STORAGE_TYPE=auto                  # auto | local | s3 | http
# DFE_STORAGE_PATH=./artifacts
# DFE_S3_BUCKET=
# DFE_S3_REGION=

# =============================================================================
# Integration tests (real ClickHouse)
# =============================================================================
# The tiered ch fixture (tests/integration/conftest.py) auto-picks, in order:
#   1 cluster: a non-localhost DFE_CLICKHOUSE_* (above) or DFE_TEST_CH_*
#   2 remote:  a docker host over ssh (DFE_TEST_DOCKER_HOST=user@host)
#   3 local:   a local docker ClickHouse
# Force a tier with DFE_TEST_TIER=cluster|remote|local; keep the spun container
# with DFE_TEST_KEEP=1.
# DFE_TEST_TIER=cluster
# DFE_TEST_CH_HOST=clickhouse.devex.hyperi.io
# DFE_TEST_CH_PORT=8123
# DFE_TEST_CH_USER=default
# DFE_TEST_CH_PASSWORD=
# DFE_TEST_DOCKER_HOST=derek@desktop-derek.devex.hyperi.io
